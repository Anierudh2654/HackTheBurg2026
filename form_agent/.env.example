# Nebius Token Factory (OpenAI-compatible chat completions API)
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=put-a-model-id-from-your-token-factory-catalog-here
NEBIUS_API_KEY=paste-your-token-locally-here

# Optional: persistent local Chrome session profile. Keep this directory private.
CHROME_PROFILE_DIR=.browser_profile
MAX_FORM_PAGES=20
